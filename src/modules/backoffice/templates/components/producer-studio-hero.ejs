<div class="ios-hero">
  <div>
    <h2 class="ios-title"><%= heroTitle %></h2>
    <div class="ios-subtitle"><%= heroSubtitle %></div>
  </div>
  <div class="ios-chip-row">
    <span class="ios-chip">Type ID <%= payload.typeId %></span>
    <span class="ios-chip">Items <%= payload.pagination ? payload.pagination.totalRows : payload.items.length %></span>
    <span class="ios-chip">EJS Components</span>
  </div>
</div>
