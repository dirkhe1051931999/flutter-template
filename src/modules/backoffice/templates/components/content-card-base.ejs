<article class="ios-card ios-item">
  <div class="ios-thumb" style="background-image:url('<%= cover || '' %>');">
    <div class="ios-overlay">
      <h3 class="ios-item-title"><%= title || '-' %></h3>
      <div class="ios-item-meta"><%= meta || '' %></div>
    </div>
  </div>
  <div class="ios-item-body">
    <% if (badgesHtml) { %><div class="ios-badges"><%- badgesHtml %></div><% } %>
    <% if (actionsHtml) { %><div class="ios-actions" style="margin-bottom:10px;"><%- actionsHtml %></div><% } %>
    <% if (releaseHtml) { %><%- releaseHtml %><% } %>
    <% if (editHtml) { %><div class="ios-edit"><%- editHtml %></div><% } %>
  </div>
</article>
