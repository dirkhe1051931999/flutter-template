<div class="ios-card">
  <details>
    <summary style="cursor:pointer; font-weight:700; color:#0f172a;">+ Add new TV show</summary>
    <form method="post" action="/producer/tvshow/save" class="ios-stack" data-rent-form style="margin-top:12px;">
      <input type="hidden" name="type_id" value="<%= payload.typeId %>" />
      <div class="ios-grid-2">
        <div><label class="ios-label">Name</label><input name="name" placeholder="Name" required /></div>
        <div><label class="ios-label">Video Type</label><select name="video_type" required><option value="">Select type</option><option value="2">2 - TV Shows</option></select></div>
      </div>
      <div class="ios-grid-3">
        <div><label class="ios-label">Category IDs</label><input name="category_id" placeholder="1,2" required /></div>
        <div><label class="ios-label">Language IDs</label><input name="language_id" placeholder="1,2" required /></div>
        <div><label class="ios-label">Cast IDs</label><input name="cast_id" placeholder="1,2" /></div>
      </div>
      <div class="ios-grid-2">
        <div><label class="ios-label">Thumbnail URL</label><input name="thumbnail" placeholder="https://..." /></div>
        <div><label class="ios-label">Landscape URL</label><input name="landscape" placeholder="https://..." /></div>
      </div>
      <div class="ios-grid-2">
        <div><label class="ios-label">Trailer Type</label><input name="trailer_type" value="external" /></div>
        <div><label class="ios-label">Trailer URL</label><input name="trailer_url" placeholder="https://..." /></div>
      </div>
      <div><label class="ios-label">Description</label><input name="description" placeholder="Description" /></div>
      <div class="ios-grid-3">
        <div><label class="ios-label">Release Date</label><input name="release_date" placeholder="YYYY-MM-DD" /></div>
        <div><label class="ios-label">Channel ID</label><input name="channel_id" value="0" /></div>
        <div><label class="ios-label">is_title</label><select name="is_title"><option value="0" selected>0</option><option value="1">1</option></select></div>
      </div>
      <div class="ios-grid-3">
        <div><label class="ios-label">is_comment</label><select name="is_comment"><option value="0">0</option><option value="1" selected>1</option></select></div>
        <div><label class="ios-label">is_like</label><select name="is_like"><option value="0">0</option><option value="1" selected>1</option></select></div>
        <div><label class="ios-label">is_rent</label><select name="is_rent" data-rent-toggle><option value="0" selected>0</option><option value="1">1</option></select></div>
      </div>
      <div class="ios-grid-2 ios-rent" data-rent-fields>
        <div><label class="ios-label">price</label><input name="price" value="0" /></div>
        <div><label class="ios-label">rent_day</label><input name="rent_day" value="0" /></div>
      </div>
      <button type="submit" class="ios-primary">Save TV Show</button>
    </form>
  </details>
</div>
